function showPage(id){document.querySelectorAll('.page').forEach(p=>p.classList.toggle('active',p.id===id));document.querySelectorAll('.nav').forEach(n=>n.classList.toggle('active',n.dataset.page===id));document.getElementById('crumb').textContent=labels[id];window.scrollTo({top:0,behavior:'smooth'})}
document.querySelectorAll('.nav[data-page]').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
function complete(id,amount,btn){if(state.done.includes(id))return;const names={quiz:'Money-smart mini quiz',checkin:'Daily check-in',learn:'Learn something new',safety:'Online safety basics'};if(id==='learn'&&!confirm('Demo guide: Set aside a small amount regularly and keep emergency savings accessible.\n\nQuestion: Is it useful to plan a savings goal?\n\nPress OK to answer “yes” and complete this sample activity.'))return;if(id==='quiz'&&!confirm('Demo quiz: A simple budget helps you plan spending and saving.\n\nPress OK to confirm you read this tip and complete the sample activity.'))return;if(id==='safety'&&!confirm('Safety tip: Never share your M-Pesa PIN or one-time code.\n\nPress OK to confirm you read this tip and complete the sample activity.'))return;if(id==='checkin'&&!confirm('Demo check-in: Think of one small goal for this week. Press OK to record your check-in.'))return;state.done.push(id);state.balance+=amount;state.activity.unshift({name:names[id],detail:'Completed · simulated credit',amount});persist();toast('KSh '+amount+' demo credit added. No cash value.')}
function copyCode(){navigator.clipboard?.writeText('JIRANI10').then(()=>toast('Invite code copied.')).catch(()=>toast('Your invite code is JIRANI10'));if(!navigator.clipboard)toast('Your invite code is JIRANI10')}
function resetDemo(){if(!confirm('Clear this browser’s demo balance and activity history?'))return;localStorage.removeItem(keys.balance);localStorage.removeItem(keys.done);localStorage.removeItem(keys.activity);state={balance:10,done:[],activity:[{name:'Welcome credit',detail:'One-time demo credit',amount:10}]};render();toast('Demo data reset.')}
let timer;function toast(s){const el=document.getElementById('toast');el.textContent=s;el.classList.add('show');clearTimeout(timer);timer=setTimeout(()=>el.classList.remove('show'),2500)}render();
</script></body></html>